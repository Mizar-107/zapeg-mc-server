{
  "uid": "zapeg-main",
  "title": "ZapeG — Sunucu",
  "tags": ["zapeg", "minecraft"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Şu An Online",
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(minecraft_player_online)", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Online Oyuncular (7g)",
      "gridPos": { "h": 6, "w": 19, "x": 5, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(minecraft_player_online)", "legendFormat": "online", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Oyun Süresi (saat)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sort_desc(sum by (player) (minecraft_play_time_ticks_total) / 72000)", "legendFormat": "{{player}}", "refId": "A" }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "h", "decimals": 1 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Ölümler",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sort_desc(sum by (player) (minecraft_deaths_total))", "legendFormat": "{{player}}", "refId": "A" }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Kazılan Blok (toplam)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sort_desc(sum by (player) (minecraft_blocks_mined_total))", "legendFormat": "{{player}}", "refId": "A" }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Kat Edilen Mesafe (km, oyuncu başına)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (player) (minecraft_movement_meters_total) / 1000", "legendFormat": "{{player}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "lengthkm", "custom": { "fillOpacity": 5, "lineWidth": 2 } }, "overrides": [] }
    }
  ],
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "editable": true
}
