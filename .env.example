# cp .env.example .env   (.env is gitignored)
# Varsayılan `mc + backup` kurulumu LLM veya Discord webhook gerektirmez.

# Varsayılan `mc + backup` kurulumu için zorunlu env yoktur.
# RCON, oyuncu parolası değil; yedek ve yönetim komutları için yalnız Docker ağı
# içinde kullanılan konsoldur. Tanımsızken sunucu rastgele üretir, backup aynı
# /data/.rcon-cli.env dosyasından otomatik bulur. Yalnız metrics profili için
# aşağıdaki satırı açıp uzun bir değer girin, sonra mc+metrics'i yeniden yaratın.
# Gerçek değeri sohbete/dokümana/repoya göndermeyin.
# RCON_PASSWORD=<openssl-rand-hex-32-output>

# Optional — image bundles a CurseForge key; set your own from
# https://console.curseforge.com/ if pack downloads get throttled.
# Use single quotes if the key contains $.
CF_API_KEY=

# Offline-mode kullanıcı adının sahibini doğrulamaz. Grup bu riski kabul etti:
# whitelist varsayılan kapalı, Mizar__107 varsayılan OP. Herkes bu adı seçip OP
# olabilir. Fikrinizi değiştirirseniz whitelist'i açın ve kalıcı OPS'i boşaltın.
ENABLE_WHITELIST=false
# Yalnız whitelist sonradan açılırsa: virgülle ayrılmış kullanıcı adları.
WHITELIST=
# Owner kararı: varsayılan kalıcı admin (offline-mode'da taklit edilebilir).
OPS=Mizar__107

# World seed — set after the seed audition (HOSTING.md), BEFORE the real world.
# This belongs to the default mc service, not an optional profile.
WORLD_SEED=
# Optional host-specific Docker CPU affinity, e.g. 0-11,16-31. Blank = all CPUs.
# Only set after checking this host's logical CPU topology and hardware health.
MC_CPUSET=

# --- opsiyonel profiller ------------------------------------------------------
# Aşağıdaki değerler ilgili --profile açılmadıkça kullanılmaz.

# Grafana admin login (metrics profile); set a long random value BEFORE enabling.
# Blank currently falls back to the known compose default and is not safe to expose.
GRAFANA_PASSWORD=
# rclone destination for offsite backups (offsite profile), e.g. b2:zapeg-backups/world
RCLONE_DEST=

# Muhtar LLM prototipi (`--profile npc`) — varsayılan stack'te ÇALIŞMAZ.
# Bu profil kapalıysa bu değerlere dokunmak gerekmez; LLM_API_KEY ve NPC_POS
# boş kalabilir (BASE_URL/MODEL satırları yalnızca varsayılanları gösterir).
# Any OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Muhtar'ın Easy NPC bedeninin koordinatı ("x y z") — yerleştirince doldur
NPC_POS=

# Heraldor (`--profile heraldor`) gömülü satır havuzuyla LLM'siz çalışır.
# HERALDOR_LLM=false iken LLM_* değerleri Heraldor tarafından kullanılmaz.
# Discord postları isteniyorsa Heraldor için AYRI ve yeni bir webhook oluştur.
# URL'yi repoya, dokümana veya sohbete yapıştırma; boşsa Discord'a yazmaz.
HERALDOR_WEBHOOK=
# Gece yarısı gölge baskınları (30 sn'lik vex, grief yok) — cesursanız true
HERALDOR_EVENTS=false
# Fısıltıları LLM üretsin mi (LLM_* değerlerini kullanır) — false = gömülü havuz
HERALDOR_LLM=false

# Advanced Heraldor timing: probability per check. These expose the knobs read
# by heraldor.py. Values below keep the ARG deliberately rare; P_DISCORD is not
# player-gated, so raising it can create posts even while nobody is online.
HERALDOR_CHECK_INTERVAL=300
HERALDOR_P_WHISPER=0.002
HERALDOR_P_GLOBAL=0.0005
HERALDOR_P_DISCORD=0.0003
HERALDOR_P_SHADOWS=0.0002

# Normal iki yönlü Minecraft ↔ Discord köprüsünde bot zorunludur; mevcut bir
# webhook URL'si verilmez. `[webhook] enable=true` botu kaldırmaz, bot yalnız
# oyuncu adı/avatar görünümü için kendi webhook'unu oluşturur. Token + kanal ID
# ilk boot'tan sonra Discord-Integration.toml'a yazılır; HOSTING.md'ye bakın.
