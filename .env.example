# cp .env.example .env   (.env is gitignored)
# Varsayılan `mc + backup` kurulumu LLM veya Discord webhook gerektirmez.

# Varsayılan `mc + backup` kurulumu için zorunlu env yoktur.
# RCON, oyuncu parolası değil; yedek ve yönetim komutları için yalnız Docker ağı
# içinde kullanılan konsoldur. Tanımsızken sunucu rastgele üretir, backup aynı
# /data/.rcon-cli.env dosyasından otomatik bulur. Yalnız metrics profili için
# aşağıdaki satırı açıp uzun bir değer girin, sonra mc+metrics'i yeniden yaratın.
# Gerçek değeri sohbete/dokümana/repoya göndermeyin.
# RCON_PASSWORD=<openssl-rand-hex-32-output>

# Optional — image bundles a CurseForge key; set your own from
# https://console.curseforge.com/ if pack downloads get throttled.
# Use single quotes if the key contains $.
CF_API_KEY=

# Offline-mode kullanıcı adının sahibini doğrulamaz. Grup bu riski kabul etti:
# whitelist varsayılan kapalı, Mizar__107 varsayılan OP. Herkes bu adı seçip OP
# olabilir. Fikrinizi değiştirirseniz whitelist'i açın ve kalıcı OPS'i boşaltın.
ENABLE_WHITELIST=false
# Yalnız whitelist sonradan açılırsa: virgülle ayrılmış kullanıcı adları.
WHITELIST=
# Owner kararı: varsayılan kalıcı admin (offline-mode'da taklit edilebilir).
OPS=Mizar__107

# World seed — set after the seed audition (HOSTING.md), BEFORE the real world.
# This belongs to the default mc service, not an optional profile.
WORLD_SEED=
# Optional host-specific Docker CPU affinity, e.g. 0-11,16-31. Blank = all CPUs.
# Only set after checking this host's logical CPU topology and hardware health.
MC_CPUSET=

# --- opsiyonel profiller ------------------------------------------------------
# Aşağıdaki değerler ilgili --profile açılmadıkça kullanılmaz.

# ZapeG Citizens shared brain (`--profile citizens`). The profile is private:
# only `mc` reaches it on Docker's internal network, and players need no key.
# Leave the URL blank to keep LLM control disabled. To enable, copy this exact
# internal URL into .env and generate a DIFFERENT random bridge token.
CITIZENS_BRAIN_URL=
CITIZENS_BRAIN_TOKEN=
# Provider settings are passed only to citizen-brain, never to `mc` or clients.
# Put the API key in secrets/citizens_ollama_api_key.txt, not in this file.
CITIZENS_LLM_URL=https://ollama.com/api/chat
CITIZENS_LLM_MODEL=gpt-oss:20b
# Protocol-3 durable-job defaults. These are limits, not targets: raise only
# after observing provider latency, TPS, model quality and SQLite growth.
CITIZENS_JOB_MAX_ACTIONS=128
CITIZENS_JOB_MAX_MODEL_CALLS=192
CITIZENS_JOB_MAX_ACTIVE_SECONDS=10800
CITIZENS_MAX_ACTIVE_JOBS=16
CITIZENS_MAX_TOOL_ARGUMENT_CHARS=262144
CITIZENS_MAX_RESULT_CHARS=16000
CITIZENS_MAX_JOB_CONTEXT_CHARS=65536
CITIZENS_MAX_JOB_CHECKPOINT_CHARS=16384
CITIZENS_MAX_JOB_RECENT_EVENTS=8
CITIZENS_MAX_JOB_INTERNAL_STEPS=8

# Grafana admin login (metrics profile); set a long random value BEFORE enabling.
# Grafana binds to localhost by default. Keep anonymous access off unless an
# authenticated VPN/reverse proxy is the only route to it.
GRAFANA_PASSWORD=
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ANONYMOUS_ENABLED=false
# rclone destination for offsite backups (offsite profile), e.g. b2:zapeg-backups/world
RCLONE_DEST=

# Heraldor (`--profile heraldor`) gömülü satır havuzuyla LLM'siz çalışır.
# HERALDOR_LLM=false iken LLM_* değerleri Heraldor tarafından kullanılmaz.
# Discord postları isteniyorsa Heraldor için AYRI ve yeni bir webhook oluştur.
# URL'yi repoya, dokümana veya sohbete yapıştırma; boşsa Discord'a yazmaz.
HERALDOR_WEBHOOK=
# Gece yarısı gölge baskınları (30 sn'lik vex, grief yok) — cesursanız true
HERALDOR_EVENTS=false
# Fısıltıları LLM üretsin mi (LLM_* değerlerini kullanır) — false = gömülü havuz
HERALDOR_LLM=false
# Only Heraldor reads these legacy OpenAI-compatible settings, and only while
# HERALDOR_LLM=true. They are unrelated to the Ollama-powered Citizens service.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Advanced Heraldor timing: probability per check. These expose the knobs read
# by heraldor.py. Values below keep the ARG deliberately rare; P_DISCORD is not
# player-gated, so raising it can create posts even while nobody is online.
HERALDOR_CHECK_INTERVAL=300
# Hidden minion-victory scoreboard ingestion interval (seconds; minimum 5).
HERALDOR_MINION_POLL_INTERVAL=10
HERALDOR_P_WHISPER=0.002
HERALDOR_P_GLOBAL=0.0005
HERALDOR_P_DISCORD=0.0003
HERALDOR_P_SHADOWS=0.0002

# Optional output-only Discord voice cameo (`--profile heraldor-voice`). Keep
# false until the relay identity, fixed channels and private rehearsal all
# pass. The Director queues only events created while this is true; historical
# suppressed events are never revived.
HERALDOR_VOICE_ENABLED=false
HERALDOR_DISCORD_GUILD_ID=
HERALDOR_DISCORD_VOICE_CHANNEL_ID=
# A separate private voice channel for `admin voice-rehearse`; never point this
# at the live channel during setup.
HERALDOR_DISCORD_TEST_VOICE_CHANNEL_ID=
# true when the token below is also used by DCI; this leaves visible presence
# under DCI's control. Use false for a dedicated, invisible Heraldor bot.
HERALDOR_DISCORD_SHARED_BOT=true
HERALDOR_VOICE_POLL_SECONDS=2
# Put the relay token in secrets/heraldor_discord_bot_token.txt. For this
# single-guild deployment it may be the same token DCI already uses; keep a
# separate secret file so the relay never needs the Minecraft config mount.
# The relay requests only Guilds + Voice States and needs only View/Connect/
# Speak/Use Voice Activity in the two fixed channels. It reads no messages.

# Normal iki yönlü Minecraft ↔ Discord köprüsünde bot zorunludur; mevcut bir
# webhook URL'si verilmez. `[webhook] enable=true` botu kaldırmaz, bot yalnız
# oyuncu adı/avatar görünümü için kendi webhook'unu oluşturur. Token + kanal ID
# ilk boot'tan sonra Discord-Integration.toml'a yazılır; HOSTING.md'ye bakın.
