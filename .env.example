# cp .env.example .env   (.env is gitignored)

# Required — used by rcon-cli, backup sidecar, scripts/
RCON_PASSWORD=change-me-long-random

# Optional — image bundles a CurseForge key; set your own from
# https://console.curseforge.com/ if pack downloads get throttled.
# Use single quotes if the key contains $.
CF_API_KEY=

# Comma-separated Minecraft usernames
WHITELIST=
OPS=
