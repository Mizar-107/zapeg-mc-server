        Label:"adventure_hub",
        Name:"Macera Haritası",
        Priority:-1,
        Texts:[{
          Text:"Keşif modları yeni biyom ve yaratık aratır; savaş yolu ekipman ve zamanlama öğretir; Ad Astra teknoloji altyapısını gezegenlere taşır; kasaba yolları yapı ve yönetim ister. Boss zinciri ise tek mod değildir: hazırlanma seviyene göre Aether/Mowzie'den Cataclysm ve daha sonrasına geçer."
        }]
      },{
        Buttons:[{
